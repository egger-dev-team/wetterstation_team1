    {
      "id": 1,
      "type": "timeseries",
      "title": "Temperatur – ML Vorhersage",
      "datasource": "InfluxDB",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "query": "from(bucket: \"wetterstation\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wetterstation_ml_forecast\" and r.source == \"prophet\" and r._field == \"temperatur\")\n  |> yield(name: \"forecast\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": true,
            "lineStyle": { "fill": "dash", "dash": [8, 4] }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "min", "max", "mean"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "none" }
