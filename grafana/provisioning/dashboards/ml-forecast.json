      "id": 8,
      "type": "table",
      "title": "Tagesempfehlungen (KI-generiert)",
      "description": "Von der KI täglich generierte Empfehlungen für Workout, Getränk und Aktivität basierend auf der Wettervorhersage",
      "datasource": "InfluxDB",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "targets": [
        {
          "query": "from(bucket: \"wetterstation\")\n  |> range(start: -2d, stop: 9d)\n  |> filter(fn: (r) => r._measurement == \"wetterstation_ml_forecast\" and r.source == \"recommendation\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"])\n  |> yield(name: \"Empfehlungen\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": { "type": "auto" },
            "filterable": false,
            "minWidth": 100
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "_time" },
            "properties": [
